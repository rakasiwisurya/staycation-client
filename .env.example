# Staycation client configuration. Copy to `.env` and adjust per environment.
# Vite only exposes variables prefixed with VITE_ to the app.

# Base URL of the backend API (includes the /api/v1/member prefix).
#   local : http://localhost:4000/api/v1/member
#   prod  : https://your-app.onrender.com/api/v1/member
VITE_API_HOST=http://localhost:4000/api/v1/member

# Optional. Base URL used to resolve relative (local-storage) image paths.
# Defaults to the origin of VITE_API_HOST, so you usually don't need to set it.
# VITE_IMAGE_HOST=http://localhost:4000
